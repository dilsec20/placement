		{
			"name": "4. Negative Test: Negative Amount (422 Unprocessable)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 422 Unprocessable Entity', function () {",
							"    pm.response.to.have.status(422);",
							"});",
							"",
							"pm.test('Error code is INVALID_AMOUNT', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.error_code).to.eql('INVALID_AMOUNT');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer test_qa_token_jwt",
						"type": "text"
					},
					{
						"key": "x-merchant-id",
						"value": "SWIGGY_PROD",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"order_id\": \"ORD_NEG_AMT\",\n    \"amount\": -250.00,\n    \"payment_method_type\": \"CARD\",\n    \"card\": {\n        \"number\": \"4111111111111111\",\n        \"cvv\": \"123\"\n    }\n}"
				},
				"url": {
					"raw": "http://localhost:8000/api/v1/txns/create",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
						"txns",
						"create"
					]
				}
			}
		},
		{
			"name": "5. Query Transaction Status (200 OK)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Transaction status is verified', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.txn_id).to.eql(pm.environment.get('saved_txn_id'));",
							"    pm.expect(jsonData).to.have.property('status');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/api/v1/txns/{{saved_txn_id}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
